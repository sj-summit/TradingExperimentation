{
  "additionalProperties": false,
  "properties": {
    "pack_id": {
      "type": "string",
      "description": "matching the pattern ^[A-Za-z0-9-]{1,64}$"
    },
    "summary": {
      "type": "string",
      "description": "at most 2000 characters"
    },
    "signal_reviews": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "signal_id": {
            "type": "string"
          },
          "went_well": {
            "type": "string",
            "description": "at most 200 characters"
          },
          "went_badly": {
            "type": "string",
            "description": "at most 200 characters"
          },
          "why": {
            "type": "string",
            "description": "at most 300 characters"
          },
          "factors": {
            "items": {
              "enum": [
                "catalyst_strong",
                "catalyst_weak_or_none",
                "catalyst_stale",
                "dilution_or_offering",
                "extreme_gap",
                "thin_liquidity",
                "sympathy_only",
                "event_day",
                "late_entry",
                "entry_slippage",
                "partial_fill",
                "trend_continuation",
                "false_breakout",
                "faded_gap",
                "stopped_by_noise",
                "news_after_entry",
                "market_tailwind",
                "market_headwind",
                "other"
              ],
              "type": "string"
            },
            "type": "array",
            "description": "at most 4 items"
          },
          "knowable_at_decision": {
            "enum": [
              "yes",
              "partly",
              "no"
            ],
            "type": "string"
          },
          "b_process": {
            "enum": [
              "good_process",
              "bad_process",
              "unclear",
              "not_applicable"
            ],
            "type": "string"
          },
          "b_note": {
            "type": "string",
            "description": "at most 200 characters"
          }
        },
        "required": [
          "signal_id",
          "went_well",
          "went_badly",
          "why",
          "factors",
          "knowable_at_decision",
          "b_process",
          "b_note"
        ],
        "type": "object"
      },
      "type": "array",
      "description": "at most 20 items"
    },
    "process_issues": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "existing_issue_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "severity": {
            "enum": [
              "info",
              "warn",
              "error"
            ],
            "type": "string"
          },
          "component": {
            "type": "string",
            "description": "at most 40 characters"
          },
          "description": {
            "type": "string",
            "description": "at most 300 characters"
          }
        },
        "required": [
          "existing_issue_id",
          "severity",
          "component",
          "description"
        ],
        "type": "object"
      },
      "type": "array",
      "description": "at most 10 items"
    },
    "lesson_proposals": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "statement": {
            "type": "string",
            "description": "at most 200 characters"
          },
          "rationale": {
            "type": "string",
            "description": "at most 400 characters"
          },
          "evidence_query": {
            "additionalProperties": false,
            "properties": {
              "filters": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "field": {
                      "enum": [
                        "catalyst_type",
                        "risk_flags",
                        "verdict",
                        "verdict_source",
                        "confidence",
                        "gap_pct",
                        "rel_vol",
                        "rel_vol_rank",
                        "or_range_atr",
                        "or_return_pct",
                        "price",
                        "atr_pct",
                        "minutes_to_trigger",
                        "regime_spy_trend",
                        "regime_vol_bucket",
                        "day_of_week",
                        "event_day"
                      ],
                      "type": "string"
                    },
                    "op": {
                      "enum": [
                        "eq",
                        "ne",
                        "gt",
                        "gte",
                        "lt",
                        "lte",
                        "in",
                        "contains"
                      ],
                      "type": "string"
                    },
                    "value": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "number"
                        },
                        {
                          "type": "boolean"
                        },
                        {
                          "items": {
                            "type": "string"
                          },
                          "type": "array"
                        }
                      ]
                    }
                  },
                  "required": [
                    "field",
                    "op",
                    "value"
                  ],
                  "type": "object"
                },
                "type": "array",
                "description": "1 to 4 items"
              },
              "compare_to": {
                "const": "complement",
                "type": "string"
              },
              "metric": {
                "const": "shadow_r",
                "type": "string"
              }
            },
            "required": [
              "filters",
              "compare_to",
              "metric"
            ],
            "type": "object"
          },
          "claimed_direction": {
            "enum": [
              "subset_worse",
              "subset_better"
            ],
            "type": "string"
          },
          "suggested_use": {
            "enum": [
              "veto_hint",
              "caution_hint",
              "allow_hint"
            ],
            "type": "string"
          }
        },
        "required": [
          "statement",
          "rationale",
          "evidence_query",
          "claimed_direction",
          "suggested_use"
        ],
        "type": "object"
      },
      "type": "array",
      "description": "at most 3 items"
    },
    "human_notes": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "existing_note_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "note": {
            "type": "string",
            "description": "at most 300 characters"
          }
        },
        "required": [
          "existing_note_id",
          "note"
        ],
        "type": "object"
      },
      "type": "array",
      "description": "at most 5 items"
    }
  },
  "required": [
    "pack_id",
    "summary",
    "signal_reviews",
    "process_issues",
    "lesson_proposals",
    "human_notes"
  ],
  "type": "object"
}
