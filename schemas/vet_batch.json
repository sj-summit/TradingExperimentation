{
  "additionalProperties": false,
  "properties": {
    "pack_id": {
      "pattern": "^[A-Za-z0-9-]{1,64}$",
      "type": "string"
    },
    "assessments": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "symbol": {
            "pattern": "^[A-Z]{1,6}$",
            "type": "string"
          },
          "catalyst_type": {
            "enum": [
              "earnings",
              "guidance",
              "fda_regulatory",
              "clinical_trial",
              "m_and_a",
              "contract_partnership",
              "product_launch",
              "analyst_action",
              "offering_dilution",
              "reverse_split",
              "legal_regulatory",
              "management_change",
              "macro_sector",
              "sympathy_move",
              "social_meme",
              "crypto_related",
              "no_identifiable_news",
              "other"
            ],
            "type": "string"
          },
          "catalyst_fresh": {
            "type": "boolean"
          },
          "catalyst_confirmed": {
            "type": "boolean"
          },
          "risk_flags": {
            "items": {
              "enum": [
                "dilution_offering",
                "shelf_or_atm",
                "reverse_split_recent",
                "promotional_or_pump",
                "stale_news",
                "rumor_unconfirmed",
                "binary_event_today",
                "earnings_after_close_today",
                "halt_or_luld_risk",
                "extreme_gap",
                "sympathy_only",
                "conflicting_reports",
                "suspicious_content"
              ],
              "type": "string"
            },
            "maxItems": 8,
            "type": "array"
          },
          "verdict": {
            "enum": [
              "allow",
              "neutral",
              "veto"
            ],
            "type": "string"
          },
          "confidence": {
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "reason": {
            "maxLength": 240,
            "type": "string"
          }
        },
        "required": [
          "symbol",
          "catalyst_type",
          "catalyst_fresh",
          "catalyst_confirmed",
          "risk_flags",
          "verdict",
          "confidence",
          "reason"
        ],
        "type": "object"
      },
      "maxItems": 25,
      "type": "array"
    }
  },
  "required": [
    "pack_id",
    "assessments"
  ],
  "type": "object"
}
