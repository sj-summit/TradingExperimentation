# env.example → copy to .env in the repo root (gitignored). Secrets only. Never commit .env.
# Claude Code is denied read access to .env by .claude/settings.json; `trader doctor` checks key names, never values.

# --- Alpaca paper account for Book A (rules only) ---
ALPACA_PAPER_A_KEY_ID=
ALPACA_PAPER_A_SECRET_KEY=

# --- Alpaca paper account for Book B (rules + Claude veto) ---
ALPACA_PAPER_B_KEY_ID=
ALPACA_PAPER_B_SECRET_KEY=

# Market data uses Book B's keys unless set explicitly (one WebSocket connection total).
ALPACA_DATA_KEY_ID=
ALPACA_DATA_SECRET_KEY=

# --- Claude subscription token for the bot (from `claude setup-token`, valid ~1 year) ---
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_TOKEN_CREATED=YYYY-MM-DD

# --- Only if llm.provider = anthropic_api (billed per token). Leave empty for the subscription path.
#     The engine strips this from the claude subprocess env unless provider is anthropic_api.
ANTHROPIC_API_KEY=

# --- SEC EDGAR fair-access User-Agent (required): your name and a contact email ---
SEC_EDGAR_USER_AGENT="Your Name your-email@example.com"

# --- Optional notifications ---
NTFY_TOPIC=
DISCORD_WEBHOOK_URL=

# --- Phase 7 only (human). Leave empty until the go-live gate. ---
ALPACA_LIVE_KEY_ID=
ALPACA_LIVE_SECRET_KEY=
TRADER_LIVE_CONFIRM=
